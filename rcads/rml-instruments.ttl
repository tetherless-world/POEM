@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/rules/> .
@prefix schema: <http://schema.org/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix poem: <http://purl.org/twc/poem/> .
@prefix vstoi: <http://purl.org/twc/vstoi/> .
@prefix fhir: <http://hl7.org/fhir/> .
@prefix sio: <http://semanticscience.org/resource/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

:TriplesMap a rr:TriplesMap;
  rml:logicalSource [
    rml:source "data/xml/10_Instruments.xml";
    rml:referenceFormulation ql:XPath;
    rml:iterator "/dataroot/_x0031_0_Instruments"
  ].

:TriplesMap3 a rr:TriplesMap;
  rml:logicalSource [
    rml:source "data/xml/03_Activities.xml";
    rml:referenceFormulation ql:XPath;
    rml:iterator "/dataroot/_x0030_3_Activities"
  ].

:TriplesMap4 a rr:TriplesMap;
  rml:logicalSource [
    rml:source "data/xml/11_InstrumentComponents.xml";
    rml:referenceFormulation ql:XPath;
    rml:iterator "/dataroot/_x0031_1_InstrumentComponents"
  ].

:TriplesMap5 a rr:TriplesMap;
  rml:logicalSource [
    rml:source "data/xml/90_Languages.xml";
    rml:referenceFormulation ql:XPath;
    rml:iterator "/dataroot/_x0039_0_Languages"
  ].

:TriplesMap6 a rr:TriplesMap;
  rml:logicalSource [
    rml:source "data/xml/94_Countries.xml";
    rml:referenceFormulation ql:XPath;
    rml:iterator "/dataroot/_x0039_4_Countries"
  ].

:TriplesMap7 a rr:TriplesMap;
  rml:logicalSource [
    rml:source "data/xml/24_Sections.xml";
    rml:referenceFormulation ql:XPath;
    rml:iterator "/dataroot/_x0032_4_Sections[ParentInstrumentID]"
  ].

:TriplesMap rr:subjectMap [
  rr:template "http://purl.org/twc/poem/individual/instrument/{InstrumentID}"
].

:TriplesMap3 rr:subjectMap [
  rr:template "http://purl.org/twc/poem/individual/activity/{ActivityID}"
].

:TriplesMap4 rr:subjectMap [
  rr:template "http://purl.org/twc/poem/individual/component/{InstrumentComponentID}"
].

:TriplesMap5 rr:subjectMap [
  rr:template "http://purl.org/twc/poem/individual/language/{LanguageID}"
].

:TriplesMap6 rr:subjectMap [
  rr:template "http://purl.org/twc/poem/individual/country/{CountryID}"
].

:TriplesMap7 rr:subjectMap [
  rr:template "http://purl.org/twc/poem/individual/section/{SectionID}"
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate rdf:type;
  rr:objectMap [ rr:constant poem:PsychometricQuestionnaire ];
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate rdf:type;
  rr:objectMap [ rr:constant fhir:Questionnaire ];
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate rdfs:label;
  rr:objectMap [
    rml:reference "InstrumentName"
  ]
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate skos:notation;
  rr:objectMap [
    rml:reference "InstrumentName"
  ]
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate fhir:code;
  rr:objectMap [
    rml:reference "InstrumentName"
  ]
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate owl:deprecated;
  rr:objectMap [
    rml:reference "Deprecated";
    rr:datatype xsd:integer
  ]
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate sio:hasAttribute;
  rr:objectMap [
    rr:template "http://purl.org/twc/poem/individual/informant/{Informant}"
  ]
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate sio:SIO_000008;
  rr:objectMap [
    rr:template "http://purl.org/twc/poem/individual/informant/{Informant}"
  ]
].

# :TriplesMap rr:predicateObjectMap [
#   rr:predicate prov:wasGeneratedBy;
#   rr:objectMap [
#     rr:parentTriplesMap :TriplesMap3;
#     rr:joinCondition [
#       rr:child "InstrumentID";
#       rr:parent "GenEntityID";
#     ];
#   ];
# ].

:TriplesMap rr:predicateObjectMap [
  rr:predicate sio:hasMember;
  rr:objectMap [
    rr:parentTriplesMap :TriplesMap4;
    rr:joinCondition [
      rr:child "InstrumentID";
      rr:parent "InstrumentID";
    ];
  ];
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate sio:SIO_000059;
  rr:objectMap [
    rr:parentTriplesMap :TriplesMap4;
    rr:joinCondition [
      rr:child "InstrumentID";
      rr:parent "InstrumentID";
    ];
  ];
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate sio:hasMember;
  rr:objectMap [
    rr:parentTriplesMap :TriplesMap7;
    rr:joinCondition [
      rr:child "InstrumentID";
      rr:parent "ParentInstrumentID";
    ];
  ];
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate sio:SIO_000059;
  rr:objectMap [
    rr:parentTriplesMap :TriplesMap7;
    rr:joinCondition [
      rr:child "InstrumentID";
      rr:parent "ParentInstrumentID";
    ];
  ];
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate sio:SIO_000008;
  rr:objectMap [
    rr:parentTriplesMap :TriplesMap5;
    rr:joinCondition [
      rr:child "Language";
      rr:parent "LanguageID";
    ];
  ];
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate sio:hasAttribute;
  rr:objectMap [
    rr:parentTriplesMap :TriplesMap5;
    rr:joinCondition [
      rr:child "Language";
      rr:parent "LanguageID";
    ];
  ];
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate sio:SIO_000008;
  rr:objectMap [
    rr:parentTriplesMap :TriplesMap6;
    rr:joinCondition [
      rr:child "Country";
      rr:parent "CountryID";
    ];
  ];
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate sio:hasAttribute;
  rr:objectMap [
    rr:parentTriplesMap :TriplesMap6;
    rr:joinCondition [
      rr:child "Country";
      rr:parent "CountryID";
    ];
  ];
].
