@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix : <http://example.org/rules/> .
@prefix schema: <http://schema.org/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix poem: <http://purl.org/twc/poem/> .
@prefix vstoi: <http://purl.org/twc/vstoi/> .
@prefix fhir: <http://hl7.org/fhir/> .
@prefix sio: <http://semanticscience.org/resource/> .
@prefix sct: <http://snomed.info/id/> .

:TriplesMap a rr:TriplesMap;
  rml:logicalSource [
    rml:source "data/xml/22_ItemStemConcepts.xml";
    rml:referenceFormulation ql:XPath;
    rml:iterator "/dataroot/_x0032_2_ItemStemConcepts"
  ].

:TriplesMap rr:subjectMap [
  rr:template "http://purl.org/twc/poem/individual/itemStemConcept/{ItemStemConceptID}"
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate rdf:type;
  rr:objectMap [ rr:constant poem:ItemStemConcept ];
].

:TriplesMap rr:predicateObjectMap [
  rr:predicate rdfs:label;
  rr:objectMap [
    rml:reference "ItemStemConcept"
  ]
].

:ItemConceptSystemMapping a rr:TriplesMap;
  rml:logicalSource [
    rml:source "data/xml/72_ItemConceptSystemMapping.xml";
    rml:referenceFormulation ql:XPath;
    rml:iterator "/dataroot/_x0037_2_ItemConceptSystemMapping[starts-with(normalize-space(Code), 'SCTID:') and normalize-space(substring-after(Code, 'SCTID:')) != '']"
  ];
  rr:subjectMap [
    rr:template "http://purl.org/twc/poem/individual/itemStemConcept/{ItemStemConceptID}"
  ];
  rr:predicateObjectMap [
    rr:predicate sio:isAbout, sio:SIO_000332;
    rr:objectMap [
      # Expand SCTID: XXXXXXXX to the IRI represented by sct:XXXXXXXX.
      rr:template "http://snomed.info/id/{normalize-space(substring-after(Code, 'SCTID:'))}";
      rr:termType rr:IRI
    ]
  ].
